# SentXStock environment variables
# Copy this file to .env and fill in real values before running the app.

# Gemini (either use one key or a comma-separated list for rotation)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# News / market data
FINNHUB_API_KEY=
NEWSAPI_KEY=
NEWSDATA_API_KEY=

# Admin auth for /api/admin/*
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional app flags
DEBUG=false
